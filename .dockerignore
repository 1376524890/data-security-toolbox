# The backend images build from the repository root (context: .) so that the
# shared detection package is inside the build context. Only backend/, shared/
# and the frontend build are ever copied, so keep everything else out: without
# this file the context would include .venv, node_modules and local data.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
.git
.gitignore
.venv
.local
**/node_modules
venv
node_modules
*.log
*.tsbuildinfo
data
*.db
*.sqlite3
.DS_Store
.env
dist
dist-offline
dist-deploy
dist-deploy.zip
dist-deploy.tar
# Persistent runtime data root (DB/Redis/storage); never part of a build context.
deploy-data
offline
local
probe_packages
uploads
reports
