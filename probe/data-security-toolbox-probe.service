[Unit]
Description=Data Security Toolbox Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dstprobe
Group=dstprobe
ExecStart=/usr/bin/python3 /opt/data-security-toolbox/probe/probe.py --config /etc/data-security-toolbox/probe.toml
Restart=always
RestartSec=5
# Read-only inventory access, including administrator-selected private directories.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/data-security-toolbox /etc/data-security-toolbox
PrivateTmp=true

[Install]
WantedBy=multi-user.target
