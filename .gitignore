*.log
*.tsbuildinfo
frontend/vite.config.js
data/
uploads/
reports/
!backend/app/templates/reports/
!backend/app/templates/reports/report.html.j2
*.db
*.sqlite3
.DS_Store

# local refactor backup (not committed)
.refactor-trash/

# local deployment artifacts (regenerable, too large for git)
dist-deploy/
dist-deploy.zip
dist-deploy.tar
# 离线镜像包（多 GB，构建产物不入库；由 scripts/offline_bundle.py --save 生成）
dist-offline/security-toolbox-images.tar
.local/
probe_packages/

# Local persistent data root for the compose stack (DB, redis, storage, reports).
# Bind-mounted so a rebuild never touches it and it can be backed up as a folder.
deploy-data/

# Built-in data detection rules are source assets.
!backend/app/rules/data/
!backend/app/rules/data/*.yar

# Third-party binaries fetched once per build host (see backend/third_party/nuclei/README.md).
backend/third_party/nuclei/*.zip
backend/third_party/nuclei/nuclei_amd64
backend/third_party/nuclei/nuclei_arm64

# Offline CIDR→country table (a source asset, rebuilt by scripts/build_egress_regions.py).
!backend/app/services/data/
!backend/app/services/data/*.json
