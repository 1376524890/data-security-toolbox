APP_NAME=Data Security Toolbox
APP_ENV=development
SECRET_KEY=replace-with-32-byte-random
DATABASE_URL=postgresql+psycopg2://security:security@postgres:5432/security_toolbox
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
STORAGE_DIR=/app/data/storage
REPORT_DIR=/app/data/reports
EXTERNAL_ENGINE_DIR=/app/data/external
MAX_UPLOAD_MB=2048
PROBE_TOKEN=replace-with-a-random-probe-token
VITE_API_BASE_URL=/api/v1
