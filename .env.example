APP_ENV=production
POSTGRES_DB=security_toolbox
POSTGRES_USER=security
POSTGRES_PASSWORD=replace-with-strong-password
SECRET_KEY=replace-with-32-plus-random-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
PROBE_BOOTSTRAP_TOKEN=replace-with-strong-bootstrap-token
HTTP_PORT=8080

# Probe server-side push deployment (optional). Set all three to enable the
# deployment plane; DEPLOYMENT_SECRET_KEY must be at least 32 chars.
DEPLOYMENT_SECRET_KEY=
DEPLOYMENT_BACKEND_URL=
DEPLOYMENT_CA_FILE=
DEPLOYMENT_KNOWN_HOSTS=
DEPLOYMENT_VERIFY_HOST_KEY=true
PROBE_AGENT_VERSION=3.4.0

PCAP_INDEX_LIMIT=10000
PCAP_RETENTION_DAYS=7
PCAP_STORAGE_MAX_GB=100
QUEUE_PENDING_MAX=200
QUEUE_OLDEST_PENDING_SECONDS=900
ALERT_SUPPRESS_WINDOW_SECONDS=300
WEBHOOK_URL=
WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Nuclei active vulnerability scanner (optional)
NUCLEI_BIN=nuclei
NUCLEI_TEMPLATES_DIR=/app/data/nuclei-templates

# Optional threat-intelligence feeds
URLHAUS_AUTH_KEY=
CUSTOM_INTEL_URL=
CUSTOM_INTEL_TOKEN=
# Network DLP must never alert on the toolbox's own traffic. The platform URL
# (DEPLOYMENT_BACKEND_URL) and the probe/console auth headers are excluded
# automatically; add sibling tooling here as host, host:port or CIDR entries.
DLP_IGNORE_OWN_TRAFFIC=true
DLP_SELF_ENDPOINTS=

# Wazuh host-audit integration (optional). Set URL + credentials to enable live alert sync.
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=true
WAZUH_POLL_SECONDS=60
WAZUH_ALERT_LIMIT=200
