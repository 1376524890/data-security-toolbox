# Offline sample for ET Open import tests and bundle validation.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET WEB_SPECIFIC Webshell Upload Attempt"; flow:established,to_server; content:"/shell.php"; http_uri; sid:2100001; rev:1; classtype:web-application-attack;)
alert dns $HOME_NET any -> any any (msg:"ET MALWARE DNS Query to Known C2 Domain"; content:"evil.example"; nocase; sid:2100002; rev:1; classtype:malware-c2;)
