<?xml version="1.0" encoding="UTF-8"?>
<!-- 平台下发的 OpenSCAP 基线（XCCDF 1.2）。由 oscap xccdf eval 执行。 -->
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_dst_baseline"
           resolved="true" xml:lang="zh-CN">
  <status date="2026-09-17">draft</status>
  <title>数据安全检查基线</title>
  <description>面向数据安全检查服务交付的主机基线检查项。</description>
  <version>1.0</version>
  <Profile id="xccdf_dst_profile_standard">
    <title>标准检查基线</title>
    <select idref="xccdf_dst_rule_data_at_rest" selected="true"/>
    <select idref="xccdf_dst_rule_audit_enabled" selected="true"/>
    <select idref="xccdf_dst_rule_tls_only" selected="true"/>
    <select idref="xccdf_dst_rule_db_local_only" selected="true"/>
  </Profile>
  <Group id="xccdf_dst_group_data">
    <title>数据保护</title>
    <Rule id="xccdf_dst_rule_data_at_rest" severity="high">
      <title>敏感数据卷必须加密</title>
      <description>承载敏感数据的文件系统必须启用加密（LUKS/自加密盘）。</description>
      <rationale>设备丢失或磁盘被离线读取时，明文数据将直接泄露。</rationale>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="dst_baseline_oval.xml" name="oval:dst_data_at_rest"/>
      </check>
    </Rule>
    <Rule id="xccdf_dst_rule_audit_enabled" severity="high">
      <title>审计服务必须开启并保留 180 天</title>
      <description>auditd 必须运行，日志保留期不少于 180 天。</description>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="dst_baseline_oval.xml" name="oval:dst_audit_enabled"/>
      </check>
    </Rule>
  </Group>
  <Group id="xccdf_dst_group_transport">
    <title>传输与暴露面</title>
    <Rule id="xccdf_dst_rule_tls_only" severity="medium">
      <title>对外服务仅允许 TLS 1.2 及以上</title>
      <description>禁止 SSLv3/TLS1.0/1.1 与弱套件。</description>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="dst_baseline_oval.xml" name="oval:dst_tls_only"/>
      </check>
    </Rule>
    <Rule id="xccdf_dst_rule_db_local_only" severity="high">
      <title>数据库端口不得对公网监听</title>
      <description>3306/5432/6379/27017 等端口只能监听内网地址。</description>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="dst_baseline_oval.xml" name="oval:dst_db_local_only"/>
      </check>
    </Rule>
  </Group>
</Benchmark>
