<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>数据安全监测检测工具箱 - 安全检测报告</title>
<style>
  body { font-family: "Microsoft YaHei", Arial, sans-serif; color: #1f2937; margin: 24px; }
  h1 { font-size: 22px; border-bottom: 2px solid #2563eb; padding-bottom: 8px; }
  h2 { font-size: 16px; color: #2563eb; margin-top: 28px; }
  table { border-collapse: collapse; width: 100%; margin-top: 8px; font-size: 12px; }
  th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
  th { background: #f3f4f6; }
  .cards { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
  .card { border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px 16px; min-width: 130px; }
  .card .num { font-size: 24px; font-weight: bold; color: #2563eb; }
  .card .label { font-size: 12px; color: #6b7280; }
  .sev-critical { color: #b91c1c; font-weight: bold; }
  .sev-high { color: #dc2626; font-weight: bold; }
  .sev-medium { color: #d97706; }
  .sev-low { color: #6b7280; }
  .meta { color: #6b7280; font-size: 12px; }
</style>
</head>
<body>
  <h1>数据安全检测报告</h1>
  <p class="meta">生成时间：{{ summary.generated_at }}</p>

  <div class="cards">
    <div class="card"><div class="num">{{ summary.asset_count }}</div><div class="label">资产</div></div>
    <div class="card"><div class="num">{{ summary.file_count }}</div><div class="label">文件</div></div>
    <div class="card"><div class="num">{{ summary.pcap_count }}</div><div class="label">PCAP</div></div>
    <div class="card"><div class="num">{{ summary.finding_count }}</div><div class="label">检测发现</div></div>
    <div class="card"><div class="num">{{ summary.incident_count }}</div><div class="label">安全事件</div></div>
    <div class="card"><div class="num">{{ summary.data_asset_count }}</div><div class="label">数据资产</div></div>
    <div class="card"><div class="num">{{ summary.anomaly_count }}</div><div class="label">异常</div></div>
    <div class="card"><div class="num">{{ summary.integration_finding_count }}</div><div class="label">集成检测</div></div>
  </div>

  {% if coverage and coverage.overall and coverage.overall.total %}
  <h2>检查覆盖</h2>
  <p>{{ coverage.overall.statement }}</p>
  <table>
    <tr><th>采集来源</th><th>已登记</th><th>完整读取</th><th>部分读取</th><th>未读取</th><th>完整读取率</th></tr>
    {% for s in coverage.sources %}
    <tr>
      <td>{{ s.label }}</td>
      <td>{{ s.total }}</td>
      <td>{{ s.complete }}</td>
      <td>{{ s.partial }}</td>
      <td>{{ s.not_inspected }}</td>
      <td>{{ s.coverage_percent }}%</td>
    </tr>
    {% endfor %}
  </table>

  {% if coverage.overall.miss_reasons %}
  <p class="meta">未完整读取的原因分布（同一对象只计一个原因）：</p>
  <table>
    <tr><th>原因</th><th>数量</th></tr>
    {% for r in coverage.overall.miss_reasons %}
    <tr><td>{{ r.label }}</td><td>{{ r.count }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if coverage.overall.samples %}
  <p class="meta">未完整读取的对象（下表为举例，共 {{ coverage.overall.samples|length }} 条；完整清单见控制台「文件证据 → 风险文件」，覆盖率选「未完整读取」——该列表只列已命中敏感规则的实例）：</p>
  <table>
    <tr><th>采集来源</th><th>对象</th><th>状态</th><th>原因</th></tr>
    {% for s in coverage.overall.samples %}
    <tr><td>{{ s.source }}</td><td>{{ s.name }}</td><td>{{ s.status_label }}</td><td>{{ s.reason_label }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if coverage.network %}
  <p class="meta">{{ coverage.network.label }}：本次覆盖 {{ coverage.network.captures }} 个抓包，提取对象 {{ coverage.network.extracted_objects }} 个，其中加密流 {{ coverage.network.encrypted_streams }} 条未能解读。{{ coverage.network.note }}</p>
  {% endif %}
  {% endif %}

  {% if findings %}
  <h2>检测发现（{{ findings|length }}）</h2>
  <table>
    <tr><th>严重度</th><th>引擎</th><th>规则</th><th>目标</th><th>风险分</th><th>置信度</th><th>时间</th><th>建议</th></tr>
    {% for f in findings %}
    <tr>
      <td class="sev-{{ f.severity|lower }}">{{ f.severity }}</td>
      <td>{{ f.engine }}</td>
      <td>{{ f.rule_id }}</td>
      <td>{{ f.target_type }}{{ ':' ~ f.target_id if f.target_id else '' }}</td>
      <td>{{ f.risk_score }}</td>
      <td>{{ f.confidence }}</td>
      <td>{{ f.timestamp }}</td>
      <td>{{ f.recommendation }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if assets %}
  <h2>资产（{{ assets|length }}）</h2>
  <table>
    <tr><th>IP</th><th>主机名</th><th>端口</th><th>服务</th><th>类型</th><th>风险</th><th>系统</th></tr>
    {% for a in assets %}
    <tr>
      <td>{{ a.ip }}</td><td>{{ a.hostname }}</td><td>{{ a.port }}</td><td>{{ a.service }}</td>
      <td>{{ a.asset_type }}</td><td>{{ a.risk_level }}</td><td>{{ a.os }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if files %}
  <h2>文件（{{ files|length }}）</h2>
  <table>
    <tr><th>名称</th><th>路径</th><th>大小</th><th>类型</th><th>SHA256</th><th>风险</th></tr>
    {% for f in files %}
    <tr>
      <td>{{ f.name }}</td><td>{{ f.path }}</td><td>{{ f.size }}</td><td>{{ f.file_type }}</td>
      <td>{{ f.sha256 }}</td><td>{{ f.risk_level }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if pcaps %}
  <h2>PCAP（{{ pcaps|length }}）</h2>
  <table>
    <tr><th>ID</th><th>文件名</th><th>接口</th><th>大小</th><th>包数</th><th>分析状态</th></tr>
    {% for p in pcaps %}
    <tr>
      <td>{{ p.id }}</td><td>{{ p.filename }}</td><td>{{ p.capture_interface }}</td><td>{{ p.size }}</td>
      <td>{{ p.packet_count }}</td><td>{{ p.analysis_status }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if incidents %}
  <h2>安全事件（{{ incidents|length }}）</h2>
  <table>
    <tr><th>标题</th><th>严重度</th><th>状态</th><th>风险分</th><th>次数</th><th>最后发现</th></tr>
    {% for i in incidents %}
    <tr>
      <td>{{ i.title }}</td><td>{{ i.severity }}</td><td>{{ i.status }}</td><td>{{ i.risk_score }}</td>
      <td>{{ i.occurrence_count }}</td><td>{{ i.last_seen }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if data_assets %}
  <h2>数据资产（{{ data_assets|length }}）</h2>
  <table>
    <tr><th>名称</th><th>类型</th><th>敏感度</th><th>来源</th></tr>
    {% for d in data_assets %}
    <tr><td>{{ d.name }}</td><td>{{ d.asset_type }}</td><td>{{ d.sensitivity }}</td><td>{{ d.source }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if anomalies %}
  <h2>异常（{{ anomalies|length }}）</h2>
  <table>
    <tr><th>名称</th><th>类型</th><th>敏感度</th><th>来源</th></tr>
    {% for a in anomalies %}
    <tr><td>{{ a.name }}</td><td>{{ a.asset_type }}</td><td>{{ a.sensitivity }}</td><td>{{ a.source }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if not findings and not assets and not files and not pcaps and not incidents %}
  <p>当前没有需要展示的检测数据。</p>
  {% endif %}
</body>
</html>