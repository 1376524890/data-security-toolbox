FROM sha256:358f08ba8fb2d8c85b5e753bbdf05e39f7c02789e40c750f921a2d245a9e0fd6

USER root

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --timeout 120 --retries 5 -r /tmp/requirements.txt

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts ./scripts

RUN chown -R appuser:appuser /app
USER appuser

CMD ["python", "-c", "from presidio_analyzer import AnalyzerEngine; print('presidio-analyzer ready'); import time; time.sleep(86400)"]
